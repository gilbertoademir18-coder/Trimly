// Schema do Trimly.
//
// A conexão vem de `prisma.config.ts`, que lê DATABASE_URL do `.env` da raiz.
// Cada módulo do app tem suas tabelas com prefixo próprio (`wl_` para o WL),
// para que o banco continue legível quando outros módulos chegarem.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Uma pesagem. No máximo uma por dia: pesar de novo no mesmo dia corrige a
/// anterior em vez de criar ruído no gráfico.
model WlPesagem {
  /// O dia da pesagem, como dia do calendário (DATE, sem hora nem fuso).
  data     DateTime @id @db.Date
  pesoKg   Decimal  @map("peso_kg") @db.Decimal(5, 2)
  nota     String?
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  @@map("wl_pesagem")
}

/// A meta do WL. Linha única (id sempre 1): é um app de uma pessoa só.
model WlMeta {
  id        Int      @id @default(1)
  pesoAlvo  Decimal  @map("peso_alvo") @db.Decimal(5, 2)
  alturaCm  Int?     @map("altura_cm")
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  @@map("wl_meta")
}

/// Uma ação que entra na pontuação do dia: `pontos` positivo soma, negativo
/// desconta. Nunca zero — ação que não vale nada não é ação.
///
/// DECIMAL e não float porque estes números entram em somas: 0,1 + 0,2 daria
/// 0,30000000000000004, o mesmo motivo do peso.
model WlAcao {
  id   Int    @id @default(autoincrement())
  nome String

  /// `null` quando os pontos moram nas opções: a ação vira um seletor no dia
  /// ("qual refeição?", "qual treino?") e cada opção vale o seu.
  pontos Decimal? @db.Decimal(5, 2)

  /// "1 copo de água" conta várias vezes no mesmo dia; "treinar", não.
  repetivel Boolean @default(false)

  /// Quantas vezes a ação é esperada num dia completo — 8, para os copos de
  /// água. É o que define quanto ela contribui para o "dia perfeito"; sem
  /// isso, uma ação repetível não teria denominador e beber muita água
  /// estouraria os 100% sozinha. Nas não repetíveis é sempre 1.
  alvoDiario Int @default(1) @map("alvo_diario")

  /// Arquivar em vez de apagar. Uma ação com histórico não pode sumir: os
  /// dias passados ficariam com registros órfãos e nota sem explicação.
  ativa Boolean @default(true)

  /// A ordem em que aparecem na tela do dia. Empate desempata por nome.
  ordem Int @default(0)

  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  registros WlRegistro[]
  opcoes    WlAcaoOpcao[]
  grupos    WlAcaoGrupo[]

  @@map("wl_acao")
}

/// Um conjunto de ações para um tipo de dia.
///
/// Dia de trabalho pede hábitos diferentes de fim de semana, e fim de semana
/// fora de casa pede outros — sem isso, o "dia perfeito" de um sábado seria
/// cobrado pelas metas de uma segunda.
model WlGrupo {
  id   Int    @id @default(autoincrement())
  nome String

  /// Em que dias da semana este grupo entra sozinho: 0 = domingo … 6 = sábado.
  /// Vazio significa "só manual" — é o caso do grupo que depende de onde você
  /// vai passar o fim de semana, que calendário nenhum adivinha.
  diasDaSemana Int[] @map("dias_da_semana")

  /// Arquivar em vez de apagar, como no resto: grupo já usado por algum dia não
  /// pode sumir sem deixar a nota daquele dia sem explicação.
  ativo Boolean @default(true)
  ordem Int     @default(0)

  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  acoes WlAcaoGrupo[]
  dias  WlDia[]

  @@map("wl_grupo")
}

/// A ligação entre ação e grupo. Uma ação pode estar em vários.
model WlAcaoGrupo {
  acaoId  Int @map("acao_id")
  grupoId Int @map("grupo_id")

  // Cascade dos dois lados: esta linha não é um dado em si, é só a ligação.
  // Apagar a ação ou o grupo (quando permitido) leva a ligação junto.
  acao  WlAcao  @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  grupo WlGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([acaoId, grupoId])
  @@index([grupoId])
  @@map("wl_acao_grupo")
}

/// Uma alternativa de uma ação com opções.
///
/// Escolhe-se uma por dia — por isso o registro aponta para uma só. O "dia
/// perfeito" conta a MELHOR opção da ação, e não a soma: somar todas faria um
/// 100% inatingível, já que só cabe uma. Escolher uma que vale menos rende
/// crédito parcial.
model WlAcaoOpcao {
  id     Int     @id @default(autoincrement())
  acaoId Int     @map("acao_id")
  nome   String
  pontos Decimal @db.Decimal(5, 2)

  /// Arquivar em vez de apagar, como nas ações: opção já escolhida em algum dia
  /// não pode sumir sem deixar a nota daquele dia sem explicação.
  ativa Boolean @default(true)
  ordem Int     @default(0)

  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  acao      WlAcao       @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  registros WlRegistro[]

  @@index([acaoId])
  @@map("wl_acao_opcao")
}

/// Uma ação feita (ou cometida) num dia.
///
/// `pontosNaEpoca` congela quanto a ação valia no momento do registro. Sem
/// isso, corrigir o peso de um hábito hoje reescreveria silenciosamente a nota
/// de todos os dias passados — e um calendário que muda sozinho não serve para
/// olhar para trás.
model WlRegistro {
  data       DateTime @db.Date
  acaoId     Int      @map("acao_id")
  quantidade Int      @default(1)

  /// A opção escolhida, nas ações que têm opções. `null` nas demais.
  opcaoId Int? @map("opcao_id")

  /// Quanto valia o que foi marcado — a opção, quando há uma; a ação, quando não.
  pontosNaEpoca Decimal @map("pontos_na_epoca") @db.Decimal(5, 2)

  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  // Restrict e não Cascade: apagar uma ação usada é erro, não decisão em
  // cascata. O caminho é arquivar (`ativa = false`).
  acao  WlAcao       @relation(fields: [acaoId], references: [id], onDelete: Restrict)
  opcao WlAcaoOpcao? @relation(fields: [opcaoId], references: [id], onDelete: Restrict)

  @@id([data, acaoId])
  @@map("wl_registro")
}

/// O denominador de um dia: a soma dos pontos das ações positivas que estavam
/// ativas quando o dia foi mexido pela última vez.
///
/// Congelado pelo mesmo motivo que `pontosNaEpoca`. Com "dia perfeito = 100%",
/// cadastrar um hábito novo aumentaria o total possível e rebaixaria todo o
/// passado de uma vez. Aqui, mexer no cadastro vale de hoje em diante.
model WlDia {
  data            DateTime @id @db.Date
  pontosPossiveis Decimal  @map("pontos_possiveis") @db.Decimal(6, 2)

  /// O grupo que valeu neste dia, congelado como o resto da foto.
  ///
  /// `null` nos dias registrados antes de os grupos existirem: eles seguem com
  /// o denominador que já tinham, porque o passado não se mexe sozinho.
  grupoId Int? @map("grupo_id")

  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  grupo WlGrupo? @relation(fields: [grupoId], references: [id], onDelete: Restrict)

  @@map("wl_dia")
}

/// Um intervalo de jejum.
///
/// Instante, e não dia: começa às 20h07 e termina às 12h15 do dia seguinte.
/// Por isso TIMESTAMPTZ, e não a coluna DATE das pesagens.
///
/// `dia` é o dia de calendário a que o jejum pertence — o do **início** —, e
/// vem decidido pelo aparelho de quem jejua. Guardá-lo explícito, em vez de
/// extrair a data de `inicio`, é o que evita o bug de fuso: a conexão roda em
/// UTC, e um jejum começado às 21h de Brasília cairia no dia seguinte se a
/// data fosse tirada do timestamp.
model WlJejum {
  id     Int       @id @default(autoincrement())
  dia    DateTime  @db.Date
  inicio DateTime  @db.Timestamptz

  /// `null` enquanto o jejum corre. Só um pode estar aberto por vez — quem
  /// garante é um índice único parcial, criado à mão na migração.
  fim DateTime? @db.Timestamptz

  /// A meta em minutos (16 h = 960). `null` é jejum livre, sem alvo.
  metaMin Int? @map("meta_min")

  nota String?

  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  @@index([dia])
  @@map("wl_jejum")
}
